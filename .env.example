# Скопировать в .env и заполнить реальными значениями
DB_PASSWORD=your_strong_password_here
JWT_SECRET=your_32_char_secret_here_change_it

# === Production URLs (важно для писем, бота, callback) ===
ADMIN_URL=https://api.esepkz.com
APP_URL=https://app.esepkz.com
LANDING_URL=https://esepkz.com

# === Telegram bot ===
TELEGRAM_BOT_TOKEN=
# Required with a bot token: independently generated 32-256 character secret.
# Use A-Z, a-z, 0-9, _ and -. Keep the same value across replicas.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=EsepKZ_bot
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=@esepfinancialsupport
